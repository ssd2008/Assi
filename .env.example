APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql://med_user:med%5Fpass@localhost:5432/med_assistant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=document_chunks_v2
MAX_DOCUMENT_SIZE_MB=10
MAX_VIDEO_SIZE_MB=2048

EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
# Windows/Docker TLS fallback after downloading into .models/multilingual-e5-large:
# EMBEDDING_MODEL_NAME=/models/local/multilingual-e5-large
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DEVICE=cpu
NORMALIZE_EMBEDDINGS=true

RERANKER_ENABLED=false
RERANKER_BACKEND=cross-encoder
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=4
RERANKER_DEVICE=cpu

ASR_BACKEND=faster-whisper
ASR_MODEL_NAME=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
# Keep transcription responsive on weaker PCs. Raise this manually on a stronger CPU if desired.
ASR_CPU_THREADS=2
ASR_NUM_WORKERS=1
VIDEO_CHUNK_DURATION_SECONDS=20
VIDEO_CHUNK_OVERLAP_SECONDS=2
VIDEO_CONTEXT_NEIGHBOR_CHUNKS=1
VIDEO_CHAPTER_MIN_SECONDS=120
VIDEO_CHAPTER_MAX_SECONDS=600
VIDEO_CHAPTER_SHIFT_THRESHOLD=0.20

# No external LLM is required by default. Chapters use local embeddings;
# highlights stay empty and chat uses extractive RAG until this is enabled.
ANSWER_BACKEND=extractive

# OpenAI-compatible generative backend (OpenAI, local gateway, vLLM, LiteLLM, etc.):
# ANSWER_BACKEND=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SECONDS=90
